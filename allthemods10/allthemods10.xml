<?xml version="1.0"?>
<Container version="2">
  <Name>allthemods10</Name>
  <Repository>w3lfare/allthemods10:latest</Repository>
  <Registry>https://hub.docker.com/r/w3lfare/allthemods10</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/180452-support-allthemods10-allthemods10-tts/</Support>
  <Project>https://www.curseforge.com/minecraft/modpacks/all-the-mods-10</Project>
  <Overview>A Modded Java Minecraft server container for Unraid that runs All the Mods 10 (ATM10).&#13;
&#13;
Persistent Custom Mods &amp; Configs (Survives Updates):&#13;
- Extra Mods: Drop .jar files into /data/custom_mods&#13;
- Custom Configs: Drop config files into /data/custom_config&#13;
&#13;
Recommended Server RAM (JVM_OPTS):&#13;
- Minimum (1-2 players): 8-10 GB (-Xms8192m -Xmx10240m)&#13;
- Recommended (2-5 players): 10-12 GB (-Xms8192m -Xmx12288m)&#13;
- Heavy / 5+ players: 14-16 GB (-Xms12288m -Xmx16384m)</Overview>
  <Category>GameServers:</Category>
  <ExtraSearchTerms>minecraft allthemods10 atm10</ExtraSearchTerms>
  <TemplateURL>https://raw.githubusercontent.com/W3LFARe/unraid_templates/main/allthemods10/allthemods10.xml</TemplateURL>
  <Icon>https://media.forgecdn.net/avatars/thumbnails/1098/957/256/256/638645426291861588.png</Icon>
<Config 
    Name="Installed Location" 
    Target="/data" Default="/mnt/user/appdata/allthemods10/" 
    Mode="rw" Description="Path to store the installed server files." 
    Type="Path" 
    Display="always" 
    Required="true" 
    Mask="false">/mnt/user/appdata/allthemods10/</Config>
<Config 
    Name="Port" 
    Target="25565" 
    Default="25565" 
    Mode="tcp" 
    Description="Port for the server" 
    Type="Port" Display="always" 
    Required="false" Mask="false">25565</Config>
<Config 
    Name="EULA" 
    Target="EULA" 
    Default="false" 
    Mode="" 
    Description="Do you agree to the Mojang EULA available at https://account.mojang.com/documents/minecraft_eula? Server will not start without accepting. Set to 'true' to accept." 
    Type="Variable" 
    Display="always" 
    Required="true" 
    Mask="false">false</Config>
<Config 
    Name="JVM_OPTS" 
    Target="JVM_OPTS" 
    Default="-Xms8192m -Xmx12288m" 
    Mode="" 
    Description="JAVA Options&#13;&#10;Performance Tip: Allocate at least 8-10 GB of RAM for 1-2 players, 10-12 GB for 2-5 players, or 14-16 GB for 5+ players." 
    Type="Variable" 
    Display="always" 
    Required="false" 
    Mask="false">-Xms8192m -Xmx12288m</Config>
<Config 
    Name="MOTD" 
    Target="MOTD" 
    Default="" 
    Mode="" 
    Description="Set the server MOTD" 
    Type="Variable" 
    Display="always" 
    Required="false" 
    Mask="false"/>
<Config 
    Name="ALLOW_FLIGHT" 
    Target="ALLOW_FLIGHT" 
    Default="true" 
    Mode="" 
    Description="Set Flight" 
    Type="Variable" 
    Display="always" 
    Required="false" 
    Mask="false">true</Config>
<Config 
    Name="MAX_PLAYERS" 
    Target="MAX_PLAYERS" 
    Default="5" 
    Mode="" 
    Description="Set Player Limit" 
    Type="Variable" 
    Display="always" 
    Required="false" 
    Mask="false">5</Config>
<Config 
    Name="ONLINE_MODE" 
    Target="ONLINE_MODE" 
    Default="true" 
    Mode="" 
    Description="Set Online Mode" 
    Type="Variable" 
    Display="always" 
    Required="false" 
    Mask="false">true</Config>
<Config 
    Name="ENABLE_WHITELIST" 
    Target="ENABLE_WHITELIST" 
    Default="true" 
    Mode="" 
    Description="Enable (true)/Disable (false) Whitelist on the Server" 
    Type="Variable" 
    Display="always" 
    Required="false" 
    Mask="false">true</Config>
<Config 
    Name="WHITELIST_USERS" 
    Target="WHITELIST_USERS" 
    Default="" 
    Mode="" 
    Description="Add Users comma-separated to the Whitelist.&#13;&#10;Example Value:&#13;&#10;TestUserName1, TestUserName2" 
    Type="Variable" 
    Display="always" 
    Required="false" 
    Mask="false"/>
<Config 
    Name="OP_USERS" 
    Target="OP_USERS"
    Default="" 
    Mode="" 
    Description="Add Users comma-separated to grant Operator status.&#13;&#10;Example Value:&#13;&#10;TestUserName1, TestUserName2" 
    Type="Variable" 
    Display="always" 
    Required="false"
    Mask="false"/>
</Container>
